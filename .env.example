# --- AI provider (choose in Settings; "mock" works offline with no key) ---
LLM_PROVIDER=mock
LLM_MODEL=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_URL=http://localhost:11434

# --- Server ---
PORT=5174
SERVER_URL=http://localhost:5174
CLIENT_URL=http://localhost:5173

# --- Corporate proxy (applied to AI and upload calls on startup) ---
# HTTPS_PROXY=http://127.0.0.1:9000
# NO_PROXY=localhost,127.0.0.1

# --- YouTube (Google Cloud OAuth client, type "Web application") ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# --- Instagram Reels (Business/Creator account linked to a Facebook Page) ---
IG_USER_ID=
IG_ACCESS_TOKEN=
# Public URL of this server (e.g. a cloudflared tunnel) so Instagram can fetch the video
# IG_GRAPH_VERSION=v21.0
PUBLIC_BASE_URL=

# --- TikTok Content Posting API (blocked in India; off unless TIKTOK_ENABLED=1) ---
TIKTOK_ENABLED=0
TIKTOK_ACCESS_TOKEN=
# SELF_ONLY until your TikTok app passes audit; then PUBLIC_TO_EVERYONE
TIKTOK_PRIVACY=SELF_ONLY

# Publishing packs from the offline demo templates is blocked (YouTube inauthentic-content risk)
ALLOW_MOCK_PUBLISH=0
